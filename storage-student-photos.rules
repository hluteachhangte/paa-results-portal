rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function emailKey() {
      return signedIn() && request.auth.token.email is string
        ? request.auth.token.email
        : "";
    }

    function phoneKey() {
      return signedIn() && request.auth.token.phone_number is string
        ? request.auth.token.phone_number
        : "";
    }

    function approvedByEmail() {
      return emailKey() != ""
        && firestore.exists(/databases/(default)/documents/approvedUsers/$(emailKey()))
        && firestore.get(/databases/(default)/documents/approvedUsers/$(emailKey())).data.active != false;
    }

    function approvedByPhone() {
      return phoneKey() != ""
        && firestore.exists(/databases/(default)/documents/approvedUsers/$(phoneKey()))
        && firestore.get(/databases/(default)/documents/approvedUsers/$(phoneKey())).data.active != false;
    }

    function approvedUser() {
      return signedIn() && (approvedByEmail() || approvedByPhone());
    }

    function approvedRole() {
      return approvedByEmail()
        ? firestore.get(/databases/(default)/documents/approvedUsers/$(emailKey())).data.role
        : approvedByPhone()
          ? firestore.get(/databases/(default)/documents/approvedUsers/$(phoneKey())).data.role
          : "";
    }

    function approvedStaffRole() {
      return approvedByEmail()
        ? firestore.get(/databases/(default)/documents/approvedUsers/$(emailKey())).data.staffRole
        : approvedByPhone()
          ? firestore.get(/databases/(default)/documents/approvedUsers/$(phoneKey())).data.staffRole
          : "";
    }

    function canManageStudentPhotos() {
      return approvedRole() in ["admin", "principal", "headmaster"]
        || approvedStaffRole() in ["admin", "principal", "headmaster"];
    }

    match /studentPhotos/{studentId}/profile.webp {
      allow read: if approvedUser();
      allow write: if canManageStudentPhotos()
        && request.resource != null
        && request.resource.size < 300 * 1024
        && request.resource.contentType.matches("image/(jpeg|png|webp)");
      allow delete: if approvedRole() == "admin" || approvedStaffRole() == "admin";
    }
  }
}
