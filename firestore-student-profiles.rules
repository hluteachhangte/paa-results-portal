rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() && request.auth.token.role is string
        ? request.auth.token.role
        : "";
    }

    function isAdmin() {
      return role() == "admin";
    }

    function isSchoolLeader() {
      return role() in ["admin", "principal", "headmaster"];
    }

    function canViewStudentData() {
      return role() in ["admin", "principal", "headmaster", "teacher"];
    }

    match /students/{studentId} {
      allow read: if canViewStudentData();
      allow create, update: if isSchoolLeader();
      allow delete: if isAdmin();
    }

    match /academicSessions/{sessionId}/enrolments/{studentId} {
      allow read: if canViewStudentData();
      allow create, update: if isSchoolLeader();
      allow delete: if isAdmin();
    }
  }
}
